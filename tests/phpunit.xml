<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="php/bootstrap.php" colors="true" cacheDirectory="../.work/phpunit-cache">
  <testsuites><testsuite name="BetterPelicanSecrets"><directory>php</directory></testsuite></testsuites>
  <php>
    <env name="APP_ENV" value="testing" force="true"/>
    <env name="DB_CONNECTION" value="sqlite" force="true"/>
    <env name="DB_DATABASE" value="/workspace/.work/panel/database/testing.sqlite" force="true"/>
